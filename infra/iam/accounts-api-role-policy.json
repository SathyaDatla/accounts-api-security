{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyTheAccountsApiRuntimeSecret",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"],
      "Resource": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:prod/accounts-api/database-*"
    },
    {
      "Sid": "DecryptOnlyThroughSecretsManagerForThatSecret",
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": "arn:aws:kms:ap-south-1:123456789012:key/11111111-2222-3333-4444-555555555555",
      "Condition": {
        "StringEquals": {"kms:ViaService": "secretsmanager.ap-south-1.amazonaws.com"},
        "StringLike": {"kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:prod/accounts-api/database-*"}
      }
    }
  ]
}
